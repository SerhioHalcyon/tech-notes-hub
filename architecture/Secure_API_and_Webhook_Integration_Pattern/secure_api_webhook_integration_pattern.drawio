          <mxGeometry height="172" width="470" x="1200" y="1448" as="geometry" />
        </mxCell>
        <mxCell id="inbound-ikey4" parent="1" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#63758A;strokeWidth=2;fontColor=#17263C;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" value="&lt;div style=&quot;font-size:19px;line-height:1.3&quot;&gt;&lt;b&gt;Operational security&lt;/b&gt;&lt;div style=&quot;font-size:16px;color:#334155;margin-top:7px&quot;&gt;HTTPS, secret rotation, least privilege&lt;br&gt;Alert on invalid signatures / DLQ growth&lt;br&gt;Never trust event data without validation&lt;/div&gt;&lt;/div&gt;" vertex="1">
