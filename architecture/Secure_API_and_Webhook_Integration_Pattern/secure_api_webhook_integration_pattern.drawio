        <mxCell id="inbound-i9" parent="1" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#E9F8EF;strokeColor=#32976B;strokeWidth=2;fontColor=#17263C;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" value="&lt;div style=&quot;font-size:18px;line-height:1.3&quot;&gt;&lt;b&gt;09  Persist and enqueue&lt;/b&gt;&lt;div style=&quot;font-size:15px;color:#334155;margin-top:7px&quot;&gt;Store accepted event durably&lt;br&gt;Use outbox / transactional handoff&lt;/div&gt;&lt;/div&gt;" vertex="1">
