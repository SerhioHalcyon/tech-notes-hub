        <mxCell id="outbound-oc1" parent="1" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#7557C7;strokeWidth=2;fontColor=#17263C;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" value="&lt;div style=&quot;font-size:19px;line-height:1.3&quot;&gt;&lt;b&gt;Credential handling&lt;/b&gt;&lt;div style=&quot;font-size:16px;color:#334155;margin-top:7px&quot;&gt;Secret manager or secure environment&lt;br&gt;Do not hardcode or log API credentials&lt;br&gt;Rotate / revoke compromised secrets&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="188" width="445" x="95" y="873" as="geometry" />
        </mxCell>
        <mxCell id="outbound-oc2" parent="1" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#FFF8DF;strokeColor=#BC912A;strokeWidth=2;fontColor=#17263C;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" value="&lt;div style=&quot;font-size:19px;line-height:1.3&quot;&gt;&lt;b&gt;Request resilience&lt;/b&gt;&lt;div style=&quot;font-size:16px;color:#334155;margin-top:7px&quot;&gt;Set bounded timeouts&lt;br&gt;Retry transient / 429 with backoff&lt;br&gt;Avoid retrying unsafe writes blindly&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="188" width="445" x="595" y="873" as="geometry" />
