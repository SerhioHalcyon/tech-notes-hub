        <mxCell id="inbound-ikey1" parent="1" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#7557C7;strokeWidth=2;fontColor=#17263C;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" value="&lt;div style=&quot;font-size:19px;line-height:1.3&quot;&gt;&lt;b&gt;Shared secret (HMAC)&lt;/b&gt;&lt;div style=&quot;font-size:16px;color:#334155;margin-top:7px&quot;&gt;Both parties know endpoint secret&lt;br&gt;Do not transmit the secret in each webhook&lt;br&gt;Example: Stripe signing secret&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="172" width="470" x="90" y="1448" as="geometry" />
        </mxCell>
        <mxCell id="inbound-ikey2" parent="1" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#7557C7;strokeWidth=2;fontColor=#17263C;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;spacingTop=12;spacingBottom=12;shadow=0;glass=0;" value="&lt;div style=&quot;font-size:19px;line-height:1.3&quot;&gt;&lt;b&gt;Public-key verification&lt;/b&gt;&lt;div style=&quot;font-size:16px;color:#334155;margin-top:7px&quot;&gt;Provider signs with private key&lt;br&gt;Your system holds verification public key&lt;br&gt;Example: SendGrid Signed Event Webhook&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="172" width="470" x="645" y="1448" as="geometry" />
        </mxCell>
